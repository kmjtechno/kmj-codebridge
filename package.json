{
  "name": "@kmjtechno/codebridge",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "KMJ CodeBridge vendor-neutral MCP coding gateway and outbound device agent",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "prettier --check src scripts tests plugin package.json .github README.md SECURITY.md docs/*.md && node scripts/check.js",
    "gateway": "node src/cli.js gateway",
    "agent": "node src/cli.js agent",
    "init": "node scripts/init.js",
    "package:plugin": "node scripts/package-plugin.js",
    "package:claude": "node scripts/package-claude.js",
    "client:config": "node scripts/client-config.js",
    "build:claude-marketplace": "node scripts/build-claude-marketplace.js",
    "check:claude-marketplace": "node scripts/build-claude-marketplace.js --check",
    "format": "prettier --write src scripts tests plugin package.json .github README.md SECURITY.md docs/*.md",
    "start": "node src/hosted-cli.js",
    "package:runtime": "node scripts/package-runtime.js",
    "test:interop": "node --test --test-concurrency=1 tests/interop.test.js",
    "test:clients": "node --test --test-concurrency=1 tests/client-packages.test.js",
    "scan:secrets": "node scripts/scan-secrets.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jose": "6.2.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "license": "Apache-2.0"
}
